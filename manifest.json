{
  "manifest_version": 3,
  "name": "82-0 Draft Helper \u2014 AI Path Odds",
  "version": "1.1.1",
  "description": "82-0.com helper with Classic scoring, sleeper flags, and projected 82-0 path probabilities.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.82-0.com/*",
    "https://82-0.com/*",
    "https://firebasestorage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "82-0 AI Draft Helper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.82-0.com/*",
        "https://82-0.com/*"
      ],
      "js": [
        "solver-core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
