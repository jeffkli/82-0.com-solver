{
  "manifest_version": 3,
  "name": "82-0 Draft Helper",
  "version": "1.0.0",
  "description": "Pick recommendations for the 82-0.com NBA draft game.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.82-0.com/*",
    "https://82-0.com/*",
    "https://firebasestorage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "82-0 Draft Helper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.82-0.com/*", "https://82-0.com/*"],
      "js": ["solver-core.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
